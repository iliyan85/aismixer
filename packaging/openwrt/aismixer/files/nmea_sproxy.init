#!/bin/sh /etc/rc.common

USE_PROCD=1

START=95
STOP=10

PROG=/usr/bin/nmea_sproxy
CONFIG=/etc/nmea_sproxy/config.yaml

KEY_TOOL=/usr/lib/aismixer/tools/aismixer_keys.py
KEYS_DIR=/etc/nmea_sproxy/keys
PRIVATE_KEY="$KEYS_DIR/station_private.pem"
PUBLIC_KEY="$KEYS_DIR/station_public.pem"


prepare_station_identity() {
	mkdir -p "$KEYS_DIR" || return 1
	chmod 0700 "$KEYS_DIR" || return 1

	if [ -f "$PRIVATE_KEY" ]; then
		/usr/bin/python3 "$KEY_TOOL" station \
			--keys-dir "$KEYS_DIR" \
			--repair-public || return 1
		return 0
	fi

	if [ -e "$PUBLIC_KEY" ]; then
		logger -t nmea_sproxy \
			"Refusing to replace incomplete station identity: public key exists without private key"
		return 1
	fi

	logger -t nmea_sproxy "Generating local nmea_sproxy station identity"

	/usr/bin/python3 "$KEY_TOOL" station \
		--keys-dir "$KEYS_DIR" || return 1
}


start_service() {
	if [ ! -f "$CONFIG" ]; then
		logger -t nmea_sproxy "Configuration not found: $CONFIG"
		return 1
	fi

	prepare_station_identity || return 1

	procd_open_instance

	procd_set_param command \
		"$PROG" \
		--config "$CONFIG"

	procd_set_param stdout 1
	procd_set_param stderr 1

	procd_set_param respawn 3600 5 5

	procd_set_param file "$CONFIG"

	procd_close_instance
}
